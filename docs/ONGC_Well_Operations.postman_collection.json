{
  "info": {
    "_postman_id": "cc07b1d2-7eb0-4b69-83f5-9a65061a5e71",
    "name": "ONGC Well Operations API",
    "description": "CRUD requests for the ONGC college internship API. This public demonstration has no authentication; do not submit confidential data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://ongc-well-operations-api.onrender.com", "type": "string" },
    { "key": "recordId", "value": "", "type": "string" },
    { "key": "wellNo", "value": "ONGC-DEMO-WELL", "type": "string" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "API information",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          }
        },
        {
          "name": "Health check",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('API and database are healthy', function () {",
                "  pm.response.to.have.status(200);",
                "  const body = pm.response.json();",
                "  pm.expect(body.status).to.eql('ok');",
                "  pm.expect(body.database).to.eql('connected');",
                "});"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Well Operations",
      "item": [
        {
          "name": "Create record",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('wellNo', 'ONGC-DEMO-' + Date.now());"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Record created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.id).to.be.a('string');",
                  "  pm.collectionVariables.set('recordId', body.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wellNo\": \"{{wellNo}}\",\n  \"job\": \"Drilling\",\n  \"purpose\": \"Postman integration test\",\n  \"dateTime\": \"2026-11-21T10:30:00+05:30\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/well-operations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "well-operations"] }
          }
        },
        {
          "name": "List records",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/well-operations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "well-operations"],
              "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Get record",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/well-operations/{{recordId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "well-operations", "{{recordId}}"] }
          }
        },
        {
          "name": "Update record",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wellNo\": \"{{wellNo}}\",\n  \"job\": \"Well testing\",\n  \"purpose\": \"Updated through Postman\",\n  \"dateTime\": \"2026-11-22T09:00:00+05:30\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/well-operations/{{recordId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "well-operations", "{{recordId}}"] }
          }
        },
        {
          "name": "Delete record",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Record deleted', function () {",
                "  pm.response.to.have.status(204);",
                "  pm.collectionVariables.set('recordId', '');",
                "});"
              ]
            }
          }],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/well-operations/{{recordId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "well-operations", "{{recordId}}"] }
          }
        }
      ]
    }
  ]
}
